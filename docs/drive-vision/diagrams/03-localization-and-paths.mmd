flowchart TB
    mount["Constants.VisionConstants<br/>Camera name + mounting position"]:::state
    cameras["Single Limelight: limelight-rear<br/>Blue-origin pose + capture time"]:::input
    sim["SimulatedDriveState Pose2d<br/>→ One Photon camera simulation"]:::input
    visionio["VisionIO inputs<br/>MT1 + relative target"]:::io
    vision["VisionSubsystem<br/>MT1 first / single-tag gyro fallback<br/>One accepted measurement"]:::logic
    state["RobotState<br/>Pose and motion history<br/>Vision estimate callback"]:::state
    ctre["DriveIOHardware / CTRE<br/>Vision time conversion<br/>Odometry telemetry ~250 Hz"]:::io
    api["Local AutoBuilder.pathfindToPose<br/>Pose2d + 6 constraint parameters"]:::logic
    grid["3 retained navgrid JSON files<br/>teleop / auto / backoff sets"]:::input
    planner["LocalADStar<br/>Background path planning"]:::logic
    command["Local PathfindingCommand<br/>Drive requirement + trajectory"]:::logic
    controller["DriveSubsystem.Controller<br/>100 Hz feedback + feedforward"]:::logic
    align["AutoAlignToPoseCommand<br/>Direct PID pose alignment"]:::logic
    output["DriveSubsystem locked output<br/>→ DriveIO → Swerve modules"]:::sink
    mount -->|"REAL mounting pose"| cameras
    mount -->|"SIM axis conversion"| sim
    cameras -->|"REAL"| visionio
    sim -->|"SIM"| visionio
    visionio -->|"main-loop read"| vision
    state -->|"historical pose / motion"| vision
    vision -->|"accepted measurement"| state
    state -->|"vision callback"| ctre
    ctre -->|"odometry / motion"| state
    grid -->|"selected obstacle set"| planner
    api -->|"creates command"| command
    command -->|"planning request"| planner
    planner -->|"new path"| command
    command -->|"trajectory"| controller
    state -->|"pose feedback"| controller
    controller -->|"locked output"| output
    state -->|"pose feedback"| align
    align -->|"requires Drive; no path search"| output
    classDef host fill:#e6eef8,stroke:#43688f,color:#172d43
    classDef input fill:#e5f4f0,stroke:#2d7868,color:#172d43
    classDef logic fill:#edf2ff,stroke:#5269ad,color:#172d43
    classDef io fill:#fff1dd,stroke:#9c7032,color:#172d43
    classDef state fill:#f2eafb,stroke:#8057a2,color:#172d43
    classDef sink fill:#eaf0f4,stroke:#627c91,color:#172d43
    classDef stop fill:#fce8e8,stroke:#a34b50,color:#172d43
    classDef decision fill:#fff7d8,stroke:#9c852d,color:#172d43
