digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.38, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=22, fontcolor="#19334c", label="04 / AprilTag aim and 1m following", labelloc=t];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14, margin="0.16,0.12", penwidth=1.3, fontcolor="#172d43"];
edge [fontname="Arial", fontsize=11, color="#7a91a5", fontcolor="#435c71", arrowsize=0.7];
ps5 [label="PS5: Square once / Triangle held\nTriangle wins; Options interrupts", fillcolor="#e5f4f0", color="#2d7868"];
gate [label="Teleop enabled + HID connected\nOptions released", fillcolor="#fff7d8", color="#9c852d"];
camera [label="limelight-rear / facing FRONT\ntv + tid + targetpose_cameraspace", fillcolor="#e5f4f0", color="#2d7868"];
time [label="NT timestamp - (cl + tl)\nReject old / malformed data", fillcolor="#edf2ff", color="#5269ad"];
mount [label="Camera at robot center\nz = 0.54m, pitch = yaw = 0", fillcolor="#f2eafb", color="#8057a2"];
geometry [label="AprilTagObservation\nRight/down/forward -> forward/left/up\nCamera-space observation record", fillcolor="#edf2ff", color="#5269ad"];
target [label="VisionSubsystem getter\nRelative tag, independent of field pose", fillcolor="#fff1dd", color="#9c7032"];
command [label="AprilTagTrackingCommand\nLock first valid tag ID\nheading = atan2(y,x), range = hypot(x,y)", fillcolor="#edf2ff", color="#5269ad"];
aim [label="Square: rotation only\nWithin 2deg for 0.15s -> finish\n3s timeout", fillcolor="#edf2ff", color="#5269ad"];
follow [label="Triangle: hold 1.0m +/- 0.05m\nFar -> forward; near -> reverse\nTurn first if error > 15deg", fillcolor="#edf2ff", color="#5269ad"];
output [label="RobotCentric: vx, vy=0, omega\nLimits: 0.6m/s and 1.5rad/s", fillcolor="#edf2ff", color="#5269ad"];
drive [label="DriveSubsystem -> DriveIO -> CTRE\nShared lock; clears old path", fillcolor="#eaf0f4", color="#627c91"];
stop [label="No valid tag / gate closed / end\nDrive.stop(): zero output\nFollow waits for same tag while held", fillcolor="#fce8e8", color="#a34b50"];
ps5 -> gate [label="input"];
gate -> command [label="allowed"];
gate -> stop [label="denied"];
camera -> time [label="one frame"];
time -> geometry [label="capture time + position"];
mount -> command [label="robotToTag transform"];
geometry -> target [label="camera-relative observation"];
target -> command [label="validated age / ID / range"];
command -> aim [label="AIM_ONCE"];
command -> follow [label="FOLLOW_WHILE_HELD"];
aim -> output [label="zero translation"];
follow -> output [label="distance + heading error"];
output -> drive [label="setControl"];
command -> stop [label="invalid / lost / finished"];
stop -> drive [label="zero output"];
}
