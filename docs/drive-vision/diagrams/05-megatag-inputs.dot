digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.38, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=22, fontcolor="#19334c", label="05 / MT2 position + MT1 heading", labelloc=t];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14, margin="0.16,0.12", penwidth=1.3, fontcolor="#172d43"];
edge [fontname="Arial", fontsize=11, color="#7a91a5", fontcolor="#435c71", arrowsize=0.7];
state [label="RobotState / blue-origin heading\nPigeon angular rate (SIM: wheel rate)", fillcolor="#f2eafb", color="#8057a2"];
orientation [label="setRobotOrientation BEFORE read\nYaw: degrees / yaw rate: degrees per second\nExternal IMU mode 0", fillcolor="#edf2ff", color="#5269ad"];
camera [label="limelight-rear / front-facing\nCenter + 0.54m / pitch 0", fillcolor="#e5f4f0", color="#2d7868"];
mt1 [label="MT1: botpose_wpiblue\nHeading + capture timestamp", fillcolor="#fff1dd", color="#9c7032"];
mt2 [label="MT2: botpose_orb_wpiblue\nXY + timestamp + tag count + distance", fillcolor="#fff1dd", color="#9c7032"];
filter [label="Both valid / fresh / within 50ms\nNo reused frames / field / distance / rotation", fillcolor="#fff7d8", color="#9c852d"];
combine [label="One Pose2d: MT2 XY + MT1 heading\nUse MT2 timestamp / heading std = 10 rad", fillcolor="#edf2ff", color="#5269ad"];
callback [label="RobotState vision callback\nDriveIO: FPGA -> CTRE time ONCE", fillcolor="#f2eafb", color="#8057a2"];
drive [label="CTRE pose estimator\nVision + gyro + wheel odometry", fillcolor="#eaf0f4", color="#627c91"];
relative [label="tv + tid + targetpose_cameraspace\nSquare / Triangle track ID 21\nIndependent of field-pose acceptance", fillcolor="#edf2ff", color="#5269ad"];
reject [label="No field-pose update\nLog Vision/RejectionReason", fillcolor="#fce8e8", color="#a34b50"];
state -> orientation [label="every periodic"];
orientation -> camera [label="robot_orientation_set"];
camera -> mt1 [label="Helper read"];
camera -> mt2 [label="Helper read"];
mt1 -> filter [label="required"];
mt2 -> filter [label="required"];
filter -> combine [label="accepted"];
filter -> reject [label="rejected"];
combine -> callback [label="one measurement"];
callback -> drive [label="latency-aware fusion"];
drive -> state [label="updated odometry"];
camera -> relative [label="separate observation"];
}
