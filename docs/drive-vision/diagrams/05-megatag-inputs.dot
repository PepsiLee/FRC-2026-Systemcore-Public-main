digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.38, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=22, fontcolor="#19334c", label="05 / Team 254 MT1 and gyro fallback", labelloc=t];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=14, margin="0.16,0.12", penwidth=1.3, fontcolor="#172d43"];
edge [fontname="Arial", fontsize=11, color="#7a91a5", fontcolor="#435c71", arrowsize=0.7];
camera [label="limelight-rear / front-facing\nCenter + 0.54m / pitch 0", fillcolor="#e5f4f0", color="#2d7868"];
mt1 [label="MT1: botpose_wpiblue\nPose + timestamp + fiducials + stddevs", fillcolor="#fff1dd", color="#9c7032"];
guard [label="Fresh / new timestamp / finite data\nValid tag metadata + positive XY stddevs", fillcolor="#fff7d8", color="#9c852d"];
main [label="254 MT1 checks\nSingle-tag ambiguity / area / yaw\nOrigin distance / Z / exclusive ID", fillcolor="#edf2ff", color="#5269ad"];
gyro [label="254 single-tag fallback\nHistorical yaw + known Reef tag\nabs(yaw rate) <= 5 rad/s", fillcolor="#edf2ff", color="#5269ad"];
state [label="RobotState\nHistorical pose + angular rate", fillcolor="#f2eafb", color="#8057a2"];
select [label="Prefer MT1; otherwise gyro fallback\nGyro does not repeat MT1 quality gates", fillcolor="#fff7d8", color="#9c852d"];
callback [label="One measurement / one timestamp\nDriveIO: FPGA -> CTRE time ONCE", fillcolor="#f2eafb", color="#8057a2"];
drive [label="CTRE pose estimator\nVision + gyro + wheel odometry", fillcolor="#eaf0f4", color="#627c91"];
relative [label="tv + tid + targetpose_cameraspace\nSquare / Triangle track ID 21\nIndependent of field-pose acceptance", fillcolor="#edf2ff", color="#5269ad"];
reject [label="No accepted candidate / useVision=false\nNo field-pose update; log reasons", fillcolor="#fce8e8", color="#a34b50"];
camera -> mt1 [label="Helper read; no MT2"];
mt1 -> guard [label="raw MT1"];
guard -> main [label="valid"];
guard -> gyro [label="valid"];
guard -> reject [label="invalid"];
state -> main [label="historical yaw"];
state -> gyro [label="pose and rate"];
main -> select [label="MT1 candidate"];
gyro -> select [label="fallback candidate"];
select -> callback [label="selected; useVision=true"];
select -> reject [label="none / disabled"];
callback -> drive [label="latency-aware fusion"];
drive -> state [label="updated pose"];
camera -> relative [label="separate observation"];
{ rank=same; main; gyro; }
}
