flowchart TB
    camera["limelight-rear / front-facing<br/>Center + 0.54m / pitch 0"]:::input
    mt1["MT1: botpose_wpiblue<br/>Pose + timestamp + fiducials + stddevs"]:::io
    guard["Fresh / new timestamp / finite data<br/>Valid tag metadata + positive XY stddevs"]:::decision
    main["254 MT1 checks<br/>Single-tag ambiguity / area / yaw<br/>Origin distance / Z / exclusive ID"]:::logic
    gyro["254 single-tag fallback<br/>Historical yaw + known Reef tag<br/>abs(yaw rate) <= 5 rad/s"]:::logic
    state["RobotState<br/>Historical pose + angular rate"]:::state
    select["Prefer MT1; otherwise gyro fallback<br/>Gyro does not repeat MT1 quality gates"]:::decision
    callback["One measurement / one timestamp<br/>DriveIO: FPGA -> CTRE time ONCE"]:::state
    drive["CTRE pose estimator<br/>Vision + gyro + wheel odometry"]:::sink
    relative["tv + tid + targetpose_cameraspace<br/>Square / Triangle track ID 21<br/>Independent of field-pose acceptance"]:::logic
    reject["No accepted candidate / useVision=false<br/>No field-pose update; log reasons"]:::stop
    camera -->|"Helper read; no MT2"| mt1
    mt1 -->|"raw MT1"| guard
    guard -->|"valid"| main
    guard -->|"valid"| gyro
    guard -->|"invalid"| reject
    state -->|"historical yaw"| main
    state -->|"pose and rate"| gyro
    main -->|"MT1 candidate"| select
    gyro -->|"fallback candidate"| select
    select -->|"selected; useVision=true"| callback
    select -->|"none / disabled"| reject
    callback -->|"latency-aware fusion"| drive
    drive -->|"updated pose"| state
    camera -->|"separate observation"| relative
    classDef host fill:#e6eef8,stroke:#43688f,color:#172d43
    classDef input fill:#e5f4f0,stroke:#2d7868,color:#172d43
    classDef logic fill:#edf2ff,stroke:#5269ad,color:#172d43
    classDef io fill:#fff1dd,stroke:#9c7032,color:#172d43
    classDef state fill:#f2eafb,stroke:#8057a2,color:#172d43
    classDef sink fill:#eaf0f4,stroke:#627c91,color:#172d43
    classDef stop fill:#fce8e8,stroke:#a34b50,color:#172d43
    classDef decision fill:#fff7d8,stroke:#9c852d,color:#172d43
